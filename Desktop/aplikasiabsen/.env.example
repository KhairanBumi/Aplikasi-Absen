# Build produksi WAJIB memakai backend asli. Mode tiruan hanya aktif saat
# development, tetapi isi ini juga supaya build yang dijalankan tanpa .env
# tidak pernah mengaktifkan mock.
VITE_USE_MOCK=false
VITE_API_BASE=/api

# Identitas PC kiosk. Harus sama dengan salah satu `kiosk_id` yang terdaftar
# di backend (lihat SEED_KIOSK_ID atau prosedur pemasangan). Tanpa ini kiosk
# mengirim UUID acak dan absen ditolak "perangkat tidak dikenal".
VITE_KIOSK_ID=kiosk-kantor-pusat

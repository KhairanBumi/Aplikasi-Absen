APP_NAME="Aplikasi Absen"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://absen.example.com
APP_FORCE_HTTPS=true

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MariaDB 10.11
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=absen
DB_USERNAME=absen
DB_PASSWORD=
DB_TIMEZONE=+07:00

# API memakai bearer token, bukan cookie sesi.
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Redis opsional. Ganti ke redis kalau tersedia; database juga bekerja.
CACHE_STORE=database
# CACHE_STORE=redis

QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_CONNECTION=log

ABSEN_TOKEN_TTL_HOURS=12
NOMINATIM_USER_AGENT="aplikasi-absen/1.0 (admin@kantor.id)"

# Wajib diisi sebelum `php artisan db:seed`. Jangan tulis PIN asli di repo.
ADMIN_NIP=
ADMIN_PIN=
ADMIN_NAMA="Administrator"
ADMIN_EMAIL=
ADMIN_DIVISI="Management Data"

# Data awal lokasi, shift, dan perangkat kiosk.
SEED_LOKASI_NAMA="Kantor Pusat"
SEED_LOKASI_ALAMAT="Jl. Jenderal Sudirman No. 1, Jakarta"
SEED_LOKASI_LINTANG=-6.2246
SEED_LOKASI_BUJUR=106.8094
SEED_LOKASI_RADIUS_M=50

SEED_SHIFT_NAMA="Reguler"
SEED_SHIFT_MASUK="08:00"
SEED_SHIFT_PULANG="17:00"
SEED_SHIFT_TOLERANSI=15

SEED_KIOSK_ID="kiosk-kantor-pusat"
SEED_KIOSK_NAMA="Kiosk Kantor Pusat"

VITE_APP_NAME="${APP_NAME}"
